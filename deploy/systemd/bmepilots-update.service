[Unit]
Description=BME Pilots verified main image update
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/bmepilots

[Service]
Type=oneshot
WorkingDirectory=/srv/bmepilots/db/deploy
ExecStart=/usr/bin/python3 /srv/bmepilots/db/deploy/scripts/update.py
TimeoutStartSec=3h
UMask=0077
Nice=10
