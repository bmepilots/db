# Copy this file to .env. Do not put passwords in .env.
DATA_ROOT=/srv/bmepilots

# Pin compatible CI-produced image tags or digests before a production update.
BACKEND_IMAGE=ghcr.io/bmepilots/backend:replace-with-immutable-tag
FRONTEND_IMAGE=ghcr.io/bmepilots/frontend:replace-with-immutable-tag

MARIADB_DATABASE=bmepilots
MARIADB_USER=bmepilots

# Create these files with sudo bash scripts/prepare.sh. Keep paths relative to this directory.
DB_PASSWORD_SECRET_FILE=./secrets/db_password
DB_ROOT_PASSWORD_SECRET_FILE=./secrets/db_root_password
BOOTSTRAP_ADMIN_PASSWORD_SECRET_FILE=./secrets/bootstrap_admin_password
MAIL_PASSWORD_SECRET_FILE=./secrets/mail_app_password

# Set before the first start; clear email after admin creation. Keep the mounted secret file.
BOOTSTRAP_ADMIN_EMAIL=admin@bmepilots2026.com

COOKIE_SECURE=true
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_INTERVAL_MS=60000
MAIL_INITIAL_DAYS=90
JAVA_OPTS=-XX:MaxRAMPercentage=75
